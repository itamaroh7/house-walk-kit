{
  "name": "house-walk-kit",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Turn a floor plan into a walkable 3D house in the browser (three.js + Vite), with a Claude Code plugin that does the work",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "vite build && node tools/prune-dist.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5181",
    "check": "node tools/check-plans.mjs",
    "assets": "node tools/fetch-assets.mjs",
    "compress": "node tools/compress-textures.mjs",
    "pack-assets": "node tools/build-asset-pack.mjs",
    "drawing:grid": "node tools/drawing-grid.mjs",
    "drawing:overlay": "node tools/drawing-overlay.mjs",
    "bench": "node tools/bench.mjs"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^0.22.0",
    "sharp": "^0.35.5",
    "vite": "^6.4.5"
  }
}
